# Sysbench smoke workload config for normal RTT sampling, not stress testing.
# Source this file from shell, then run sysbench with these values.

SYSBENCH_LUA="uprobe/test/sysbench_test/sysbench_print_sql.lua"
SYSBENCH_SQL_OUTPUT="uprobe/test/sysbench_test/sysbench_smoke_generated.sql"

SYSBENCH_MYSQL_HOST="7.27.43.145"
SYSBENCH_MYSQL_PORT="2881"
SYSBENCH_MYSQL_USER="root@ebpf_tenant"
SYSBENCH_MYSQL_PASSWORD=""
SYSBENCH_MYSQL_DB="test"

SYSBENCH_TABLE_NAME="sbtest_rtt_smoke"
SYSBENCH_TABLE_SIZE="10000"
SYSBENCH_RANGE_SIZE="100"

SYSBENCH_PREPARE_THREADS="1"
SYSBENCH_RUN_THREADS="4"
SYSBENCH_RUN_TIME="120"
SYSBENCH_RUN_EVENTS="0"
SYSBENCH_REPORT_INTERVAL="1"
